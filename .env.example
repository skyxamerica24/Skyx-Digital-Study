# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional VPS Local Disk Storage Adapter (Server-Side Only — No Docker Required)
# Leave SKYX_STORAGE_MODE="portable" on AI Studio / serverless runtimes.
# In vps_local mode, Extract Studio saves original PDFs under SKYX_VPS_STORAGE_DIR/originals
# and stores extracted pages in PostgreSQL. Use a persistent directory outside public/.
# SKYX_VPS_STORAGE_TOKEN controls the separate .skyxbook.json file-management API.
SKYX_STORAGE_MODE="portable"
SKYX_VPS_STORAGE_DIR=""
SKYX_VPS_STORAGE_TOKEN=""

# PostgreSQL and authentication. Configure on the server that hosts the app.
DATABASE_URL=
JWT_SECRET=

# Optional Book Reader defaults until an administrator saves a selection.
SKYX_READER_KEY_SLOT="GEMINI_API_KEY"
SKYX_READER_LIVE_MODEL=""
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Required for keys entered in API Management. Keep it private and stable across restarts.
SKYX_READER_MASTER_KEY=""
# Optional persistent private directory for reader bindings and encrypted keys.
SKYX_READER_CONFIG_DIR=""


# Customer-facing directions for manually verified payments. Leave empty to disable order submission.
SKYX_STORE_PAYMENT_INSTRUCTIONS=

# HTTPS mail relay for password recovery. See README for the request format.
SKYX_RESET_MAIL_WEBHOOK=
SKYX_RESET_MAIL_KEY=
